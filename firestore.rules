rules_version = '2';

// Germany Job Mission — private single-user tool.
//
// NOBODY reaches this data from a browser. Not you, not another app in this
// Firebase project, not a stranger who signs up.
//
// That is deliberate and it is the strongest setting available here: this app
// never uses the Firestore client SDK. Every read and write goes through its
// own server, which uses the Firebase Admin SDK — and the Admin SDK bypasses
// these rules entirely. So denying every client request costs the app nothing
// and removes the whole class of "somebody signed up and read everything".
//
// Who may use the app is decided in front of the database instead: Firebase
// Auth plus OWNER_UIDS, checked on the server for every single request.
//
// Publish with: npm run deploy-rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
