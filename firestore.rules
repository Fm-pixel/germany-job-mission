rules_version = '2';

// Germany Job Mission — private single-user tool.
//
// Everything is denied by default. Only the owner's own Firebase user id(s)
// may read or write. There is more than one id because there is more than one
// way to sign in: Google and email/password share an id when the address
// matches, but a phone sign-in is always a separate user.
//
// Put every id you sign in with in the list below — the same ones as OWNER_UIDS
// in the environment. `npm run deploy-rules` fills them in for you.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerUids() {
      return ['REPLACE_WITH_YOUR_OWNER_UID'];
    }

    function isOwner() {
      return request.auth != null && request.auth.uid in ownerUids();
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
