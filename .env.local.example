# ---------------------------------------------------------------------------
# Germany Job Mission — environment variables
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# The numbered steps are explained in SETUP_FOR_ME.md.
# ---------------------------------------------------------------------------

# --- Step 1: Firebase web app config (Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Step 1: Firebase service account (Project settings -> Service accounts)
# The WHOLE downloaded JSON file, on one line, in single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Your own Firebase user ID (Authentication -> Users -> copy "User UID").
# Only this user may read or write anything.
OWNER_UID=

# --- Step 2: private Google Drive folder for documents
GOOGLE_DRIVE_FOLDER_ID=

# --- Step 3: Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-4-6)
ANTHROPIC_MODEL=

# --- Step 4: email sending. Fill in EITHER the Resend block OR the Gmail block.
EMAIL_FROM=
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Where the daily summary and the weekly report are sent (your own address).
OWNER_EMAIL=

# --- Step 5: automation
# A long random word. The cron routes refuse to run without it.
CRON_SECRET=
# The public address of the app, e.g. https://germany-job-mission.vercel.app
APP_URL=

# --- Optional: job source key override (the public default already works)
BA_JOBSUCHE_API_KEY=

# ---------------------------------------------------------------------------
# Local testing only (never set these in production):
#   GJM_DB_DRIVER=local-file   store data in ./.gjm-data instead of Firestore
#   GJM_LOCAL_MODE=1           enable the local test login (no Firebase)
#   GJM_LOCAL_PASSWORD=...     required for that test login — there is no default
# ---------------------------------------------------------------------------
